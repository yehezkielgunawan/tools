{
  "name": "yehezgun-tools",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate:og-logo && pnpm run generate:pwa-icons && rsbuild build",
    "check": "biome check .",
    "dev": "rsbuild",
    "format": "biome format --write .",
    "generate:og-logo": "node scripts/generate-og-logo.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "lint": "rslint",
    "preview": "rsbuild preview",
    "migrate:biome": "biome migrate",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@rsbuild/core": "^2.2.5",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rslint/core": "^0.9.0",
    "@rstest/adapter-rsbuild": "^0.11.12",
    "@rstest/core": "^0.11.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "daisyui": "^5.7.37",
    "happy-dom": "^20.14.0",
    "rsbuild-plugin-pwa": "^2.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
